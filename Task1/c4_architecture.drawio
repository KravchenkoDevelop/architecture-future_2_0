        </mxCell>

        <!-- inventorySystem -->
        <mxCell id="h2" value="&lt;b&gt;Система инвентаризации&lt;/b&gt;&lt;br&gt;&lt;i&gt;[SaaS · Custom Service]&lt;/i&gt;&lt;br&gt;Медоборудование, склад, закупки"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#1ba1e2;strokeColor=#006EAF;fontColor=#ffffff;fontSize=10;align=center;"
          vertex="1" parent="1">
