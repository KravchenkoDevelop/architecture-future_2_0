        <mxCell id="e2" value="&lt;b&gt;Производитель медоборудования&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;Телеметрия оборудования (MQTT / Kafka)"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="735" y="1060" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="&lt;b&gt;Регуляторы&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;ЦБ, Минздрав — регламентированная отчётность"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;align=center;"
