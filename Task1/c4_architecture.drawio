        <!-- fintechDP -->
        <mxCell id="f3" value="&lt;b&gt;Data Product: Финтех&lt;/b&gt;&lt;br&gt;&lt;i&gt;[dbt + Spark]&lt;/i&gt;&lt;br&gt;Финансовые KPI, кредитный портфель → Lakehouse. Сценарий: управленческая отчётность"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#23A26D;strokeColor=#005733;fontColor=#ffffff;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="1150" y="850" width="410" height="90" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════
             DOMAIN: ГОЛОВНОЙ ОФИС (HQ)
        ═══════════════════════════════════════════════════════ -->
        <mxCell id="b4" value="&lt;b&gt;Домен: Головной офис (HQ)&lt;/b&gt;"
