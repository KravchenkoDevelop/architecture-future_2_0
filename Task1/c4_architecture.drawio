<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.0.0" type="device">
  <diagram name="C4 Container — Будущее 2.0" id="future20-c4-arch">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══════════════════════════════════════════════════════
             TITLE
        ═══════════════════════════════════════════════════════ -->
        <mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:18px;&quot;&gt;Целевая архитектура «Будущее 2.0» — через год&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;&quot;&gt;C4 Container Diagram · Data Mesh + Cloud-Native · Заменяет монолитный DWH SQL Server 2008&lt;/font&gt;"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=1;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="400" y="1420" width="1600" height="70" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════
             PERSONS
        ═══════════════════════════════════════════════════════ -->
        <mxCell id="p1" value="&lt;b&gt;Бизнес-аналитик / Менеджер&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Строит отчёты самостоятельно, анализирует KPI компании"
          style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#1ba1e2;strokeColor=#006EAF;fontColor=#ffffff;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="90" y="20" width="160" height="130" as="geometry" />
        </mxCell>

        <mxCell id="p2" value="&lt;b&gt;Врач / Оператор клиники&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Работает с пациентами, назначает лечение, использует ИИ-диагностику"
          style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#1ba1e2;strokeColor=#006EAF;fontColor=#ffffff;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="390" y="20" width="160" height="130" as="geometry" />
        </mxCell>

        <mxCell id="p3" value="&lt;b&gt;Клиент финтех&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Использует банковские и финансовые сервисы экосистемы"
          style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#1ba1e2;strokeColor=#006EAF;fontColor=#ffffff;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="1220" y="20" width="160" height="130" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════
             PLATFORM BOUNDARY
        ═══════════════════════════════════════════════════════ -->
        <mxCell id="b0" value="&lt;b&gt;Платформенный слой (Cloud)&lt;/b&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=6;opacity=60;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="195" width="1990" height="270" as="geometry" />
        </mxCell>

        <!-- selfService -->
        <mxCell id="c1" value="&lt;b&gt;Портал самообслуживания&lt;/b&gt;&lt;br&gt;&lt;i&gt;[React + Apache Superset]&lt;/i&gt;&lt;br&gt;Самостоятельное построение отчётов по любым срезам в рамках доступа. Сценарий: быстрая отчётность, управленческие решения"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#1ba1e2;strokeColor=#006EAF;fontColor=#ffffff;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="250" height="120" as="geometry" />
        </mxCell>

        <!-- biLayer -->
        <mxCell id="c2" value="&lt;b&gt;BI-система&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Power BI — обновлённый]&lt;/i&gt;&lt;br&gt;Готовые дашборды и регламентированные отчёты. Читает из Lakehouse, не из DWH"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#1ba1e2;strokeColor=#006EAF;fontColor=#ffffff;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="330" y="250" width="215" height="120" as="geometry" />
        </mxCell>

        <!-- lakehouse — ключевой компонент, выделен тёмно-синим -->
        <mxCell id="c3" value="&lt;b&gt;Data Lakehouse&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Delta Lake · Cloud Object Storage]&lt;/i&gt;&lt;br&gt;Единое аналитическое хранилище. Замена DWH SQL Server 2008. Сценарий: быстрая отчётность, масштабирование"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#0050ef;strokeColor=#001DBC;fontColor=#ffffff;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="565" y="250" width="270" height="120" as="geometry" />
        </mxCell>

        <!-- dataCatalog -->
        <mxCell id="c4" value="&lt;b&gt;Каталог данных и Governance&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Apache Atlas · AWS Glue Catalog]&lt;/i&gt;&lt;br&gt;Метаданные, Data Lineage, RBAC. Сценарий: регуляторные требования 152-ФЗ, ЦБ"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#1ba1e2;strokeColor=#006EAF;fontColor=#ffffff;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="855" y="250" width="255" height="120" as="geometry" />
        </mxCell>

        <!-- kafka — фиолетовый, ключевая шина -->
        <mxCell id="c5" value="&lt;b&gt;Event Streaming (Kafka)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Apache Kafka · Confluent Cloud]&lt;/i&gt;&lt;br&gt;Замена ESB. Асинхронная интеграция доменов. Сценарий: независимое развитие направлений"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#6a00ff;strokeColor=#3700b3;fontColor=#ffffff;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="1130" y="250" width="255" height="120" as="geometry" />
        </mxCell>

        <!-- apiGw -->
        <mxCell id="c6" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Kong · AWS API Gateway]&lt;/i&gt;&lt;br&gt;Единая точка входа для партнёров. Rate limiting, аутентификация. Сценарий: интеграция новых бизнесов"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#1ba1e2;strokeColor=#006EAF;fontColor=#ffffff;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="1405" y="250" width="230" height="120" as="geometry" />
        </mxCell>

        <!-- iam -->
        <mxCell id="c7" value="&lt;b&gt;IAM / SSO&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Keycloak · Azure AD B2C]&lt;/i&gt;&lt;br&gt;Единая аутентификация и ролевой доступ (RBAC) для всех систем и данных"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#1ba1e2;strokeColor=#006EAF;fontColor=#ffffff;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="1655" y="250" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════
             DOMAIN: КЛИНИКИ (МЕДИЦИНА)
        ═══════════════════════════════════════════════════════ -->
        <mxCell id="b1" value="&lt;b&gt;Домен: Клиники (Медицина)&lt;/b&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=6;opacity=60;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="600" height="450" as="geometry" />
        </mxCell>

        <!-- clinicApp -->
        <mxCell id="m1" value="&lt;b&gt;Клиническая система&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Web App · React PWA]&lt;/i&gt;&lt;br&gt;Замена PowerBuilder. Работа с пациентами, расписание, направления. Сценарий: операционная работа врачей"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#1ba1e2;strokeColor=#006EAF;fontColor=#ffffff;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="60" y="585" width="265" height="110" as="geometry" />
        </mxCell>

        <!-- emr — оранжевый, т.к. защищённые данные, не в аналитике -->
        <mxCell id="m2" value="&lt;b&gt;EMR / FHIR R4 Service&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Java · FHIR R4 API]&lt;/i&gt;&lt;br&gt;Медкарты, истории болезней, снимки. ⚠️ НЕ передаётся в аналитику. Compliance: 152-ФЗ, медицинская тайна"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#d79b00;strokeColor=#9E6B00;fontColor=#ffffff;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="355" y="585" width="265" height="110" as="geometry" />
        </mxCell>

        <!-- clinicDb -->
        <mxCell id="m3" value="&lt;b&gt;Операционная БД Клиник&lt;/b&gt;&lt;br&gt;&lt;i&gt;[PostgreSQL · Cloud-managed]&lt;/i&gt;&lt;br&gt;Визиты, расписание, инвентарь клиники"
          style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#1ba1e2;strokeColor=#006EAF;fontColor=#ffffff;fontSize=10;align=center;boundedLbl=1;backgroundOutline=1;size=15;"
          vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="265" height="110" as="geometry" />
        </mxCell>

        <!-- clinicDP — зелёный, Data Product -->
        <mxCell id="m4" value="&lt;b&gt;Data Product: Клиники&lt;/b&gt;&lt;br&gt;&lt;i&gt;[dbt + Spark]&lt;/i&gt;&lt;br&gt;Анонимизированные агрегаты → Lakehouse. Статистика визитов, загрузка, финансы. БЕЗ медкарт"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#23A26D;strokeColor=#005733;fontColor=#ffffff;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="355" y="720" width="265" height="110" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════
             DOMAIN: ИИ-СЕРВИСЫ
        ═══════════════════════════════════════════════════════ -->
        <mxCell id="b2" value="&lt;b&gt;Домен: ИИ-сервисы&lt;/b&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=6;opacity=60;"
          vertex="1" parent="1">
          <mxGeometry x="660" y="520" width="450" height="450" as="geometry" />
        </mxCell>

        <!-- aiPlatform -->
        <mxCell id="a1" value="&lt;b&gt;ИИ-платформа&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Python · FastAPI · MLflow]&lt;/i&gt;&lt;br&gt;Диагностика по снимкам, анализ медданных. Независимый деплой моделей. Сценарий: качество медицинских сервисов"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#1ba1e2;strokeColor=#006EAF;fontColor=#ffffff;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="680" y="585" width="410" height="110" as="geometry" />
        </mxCell>

        <!-- aiStore -->
        <mxCell id="a2" value="&lt;b&gt;Хранилище ИИ&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Object Storage S3 · Vector DB]&lt;/i&gt;&lt;br&gt;Модели (артефакты), датасеты для обучения, результаты инференса"
          style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#1ba1e2;strokeColor=#006EAF;fontColor=#ffffff;fontSize=10;align=center;boundedLbl=1;backgroundOutline=1;size=15;"
