        <!-- corpDP -->
        <mxCell id="h3" value="&lt;b&gt;Data Product: HQ / Корп.&lt;/b&gt;&lt;br&gt;&lt;i&gt;[dbt]&lt;/i&gt;&lt;br&gt;HR-метрики, консолидированный P&amp;L → Lakehouse. Сценарий: управленческая отчётность"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#23A26D;strokeColor=#005733;fontColor=#ffffff;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="1620" y="720" width="390" height="110" as="geometry" />
