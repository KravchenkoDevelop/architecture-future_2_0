          <mxGeometry x="680" y="720" width="410" height="110" as="geometry" />
        </mxCell>

        <!-- aiDP -->
        <mxCell id="a3" value="&lt;b&gt;Data Product: ИИ-метрики&lt;/b&gt;&lt;br&gt;&lt;i&gt;[dbt]&lt;/i&gt;&lt;br&gt;Точность моделей, статистика использования ИИ → Lakehouse"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#23A26D;strokeColor=#005733;fontColor=#ffffff;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="680" y="850" width="410" height="90" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════
             DOMAIN: ФИНТЕХ
        ═══════════════════════════════════════════════════════ -->
        <mxCell id="b3" value="&lt;b&gt;Домен: Финтех (Банк)&lt;/b&gt;"
