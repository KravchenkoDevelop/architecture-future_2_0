          <mxGeometry x="1130" y="520" width="450" height="450" as="geometry" />
        </mxCell>

        <!-- fintechCore -->
        <mxCell id="f1" value="&lt;b&gt;Финтех-ядро&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Golang + Java · Микросервисы]&lt;/i&gt;&lt;br&gt;Счета, кредиты, платежи, банковские операции. Сценарий: финансовые сервисы, выручка банка"
          style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#1ba1e2;strokeColor=#006EAF;fontColor=#ffffff;fontSize=10;align=center;"
          vertex="1" parent="1">
          <mxGeometry x="1150" y="585" width="410" height="110" as="geometry" />
        </mxCell>

        <!-- fintechDb -->
        <mxCell id="f2" value="&lt;b&gt;Финансовая БД&lt;/b&gt;&lt;br&gt;&lt;i&gt;[PostgreSQL + Redis · Cloud-managed]&lt;/i&gt;&lt;br&gt;Счета, транзакции, кредитные договоры"
          style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#1ba1e2;strokeColor=#006EAF;fontColor=#ffffff;fontSize=10;align=center;boundedLbl=1;backgroundOutline=1;size=15;"
          vertex="1" parent="1">
          <mxGeometry x="1150" y="720" width="410" height="110" as="geometry" />
